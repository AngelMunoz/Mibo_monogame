<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Platform.fs" />
    <Compile Include="Movement.fs" />
    <Compile Include="Physics.fs" />
    <Compile Include="Rotation.fs" />
    <Compile Include="Player.fs" />
    <Compile Include="Grid.fs" />
    <Compile Include="Game.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Mibo/Mibo.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content/Content.mgcb" />
  </ItemGroup>

</Project>
