<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>_3DSample</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Domain layer: core types -->
    <Compile Include="Domain/Domain.Types.fs" />

    <!-- Level layer: cell types → stamps → build -->
    <Compile Include="Level/Level.Cells.fs" />
    <Compile Include="Level/Level.Stamps.fs" />
    <Compile Include="Level/Level.Build.fs" />

    <!-- Systems layer: game logic -->
    <Compile Include="Systems/Systems.Platform.fs" />
    <Compile Include="Systems/Systems.Movement.fs" />
    <Compile Include="Systems/Systems.Physics.fs" />
    <Compile Include="Systems/Systems.Rotation.fs" />
    <Compile Include="Systems/Systems.Respawn.fs" />

    <!-- Rendering layer: commands → processor → features -->
    <Compile Include="Rendering/Rendering.Commands.fs" />
    <Compile Include="Rendering/Rendering.Processor.fs" />
    <Compile Include="Rendering/Rendering.Grid.fs" />
    <Compile Include="Rendering/Rendering.Player.fs" />

    <!-- Entry point -->
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mibo/Mibo.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content/Content.mgcb" />
  </ItemGroup>
</Project>
